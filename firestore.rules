rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Zugangs-Allowlist (Private Beta): Doc-ID = Google-E-Mail in lowercase.
    // Pflege ausschließlich über die Firebase Console — Clients haben keinerlei
    // Zugriff auf die Collection (siehe Match-Block unten).
    // Wichtig: Eingeloggt ≠ freigeschaltet. Der Google-Login steht technisch jedem
    // offen; nutzbar ist die App nur für gelistete Konten.
    function allowedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }

    // Eigentümer-Check für User-Daten: eigene UID UND freigeschaltet.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId && allowedUser();
    }

    // Nur Console/Admin SDK — kein Lesen/Schreiben durch Clients.
    // (exists() in allowedUser() braucht keine Client-Leserechte.)
    match /allowlist/{email} {
      allow read, write: if false;
    }

    // Globaler Übungskatalog: für freigeschaltete User lesbar und pflegbar.
    // ID + Typ sind nach dem Anlegen unveränderlich; Löschen nur über die Console.
    match /exercises/{exerciseId} {
      // Validiert den Ergebniszustand des Writes (bei merge: Bestand + Änderung).
      function validExercise() {
        let d = request.resource.data;
        return d.keys().hasOnly(['id', 'name', 'type', 'muscleGroup', 'contextDependent', 'repsProgression'])
          && d.id is string
          && d.id == exerciseId
          && d.name is string
          && d.name.size() > 0
          && d.name.size() <= 100
          && d.type in ['weighted', 'reps_only', 'cardio_basic']
          && d.muscleGroup is string
          && d.muscleGroup.size() > 0
          && d.muscleGroup.size() <= 50
          && d.contextDependent is bool
          && (!('repsProgression' in d) || d.repsProgression is bool);
      }
      allow read: if allowedUser();
      allow create: if allowedUser() && validExercise();
      // Typ bleibt fix — historische Sätze hängen daran (Edit-UI sperrt ihn ebenfalls).
      allow update: if allowedUser()
        && validExercise()
        && request.resource.data.type == resource.data.type;
      allow delete: if false;
    }

    // User-eigene Daten: ausschließlich der jeweilige (freigeschaltete) User.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /studios/{studioId} {
        allow read, write: if isOwner(userId);
      }

      match /weightHistory/{entryId} {
        allow read, write: if isOwner(userId);
      }

      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }

      // KI-Empfehlungen (Audit/Eval/Transparenz) — nur der jeweilige User.
      match /recommendations/{recId} {
        allow read, write: if isOwner(userId);
      }

      // Trainings inkl. verschachtelter Übungen und Sätze.
      match /trainings/{trainingId} {
        allow read, write: if isOwner(userId);

        match /exercises/{trainingExerciseId} {
          allow read, write: if isOwner(userId);

          match /sets/{setId} {
            allow read, write: if isOwner(userId);
          }
        }
      }
    }

    // Deny-by-default: alles, was hier nicht explizit erlaubt ist, ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
